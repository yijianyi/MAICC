+out=Path(a.output_dir)
+(out/'summary.json').write_text(json.dumps({'status':'complete','tasks':[r]}))
+with (out/'episodes.csv').open('w',newline='') as f:
+ rows=[dict(meta,episode=i+1,seed=seed+i) for i in range(n)]
