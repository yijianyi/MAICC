+#!/usr/bin/env python3
+"""Bounded, single-GPU subprocess evaluation, one sequential memory stream per condition."""
+from __future__ import annotations
+
+import argparse
+import csv
+import hashlib
+import json
+import os
+from pathlib import Path
+import signal
+import shutil
+import subprocess
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / 'src'))
+from tabx.config import load_yaml_config
+from tabx.manifest import TabxManifest
+from tabx.task_package import infer_raw_data_root, load_task_definitions
+from tabx.teammate_modes import load_teammate_modes, condition_metadata, add_baseline_deltas
+
+
+def atomic_json(path, payload):
+    temporary = path.with_suffix(path.suffix + '.tmp')
+    temporary.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + '\n')
+    temporary.replace(path)
+
+
+def parse_args():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--config', type=Path, required=True)
+    p.add_argument('--checkpoint', type=Path, required=True)
+    p.add_argument('--output-dir', type=Path, required=True)
+    p.add_argument('--gpu-id', type=int, default=0)
+    p.add_argument('--parallel-jobs', type=int, default=4)
+    p.add_argument('--cpu-threads', type=int, default=1)
+    p.add_argument('--cpus-per-job', type=int, default=2,
+                   help='Pin each worker to this many allowed logical CPUs; 0 disables affinity')
+    p.add_argument('--faiss-threads', type=int, default=1)
+    p.add_argument('--teammate-config', type=Path)
+    p.add_argument('--task-id', action='append', dest='task_ids')
+    p.add_argument('--episodes', type=int, default=100)
+    p.add_argument('--seed', type=int, default=10000)
+    p.add_argument('--episode-limit', type=int, default=512)
+    p.add_argument('--raw-data-root', type=Path)
+    p.add_argument('--task-package-root', type=Path, action='append', default=[])
+    p.add_argument('--tabx-root', type=Path, default=ROOT / 'TABX')
+    for name in ('allies', 'enemies', 'zones'):
+        p.add_argument('--max-' + name, type=int)
+    p.add_argument('--disable-online-memory', action='store_true')
+    p.add_argument('--resume', action='store_true')
+    p.add_argument('--invalid-mode-policy', choices=('skip', 'error'), default='skip',
+                   help='Skip and report task/mode pairs that leave no model ally or select invalid slots')
+    p.add_argument('--dry-run', action='store_true', help='Print condition plan without writing or starting workers')
+    args = p.parse_args()
+    if min(args.parallel_jobs, args.cpu_threads, args.faiss_threads, args.episodes, args.episode_limit) < 1:
+        p.error('job/thread/episode counts and episode-limit must be positive')
+    if args.gpu_id < 0 or args.seed < 0 or args.cpus_per_job < 0:
+        p.error('gpu-id, seed and cpus-per-job must be nonnegative')
+    return args
+
+
+def plan_conditions(tasks, definitions, modes, max_allies, invalid_policy):
+    import numpy as np
+    jobs, skipped = [], []
+    for task in tasks:
+        scenario = definitions[task.task_id].task['scenario']
+        teams = np.asarray(scenario['teams']).reshape(-1)
+        disabled = np.asarray(scenario.get('is_disabled', np.zeros_like(teams))).reshape(-1)
+        active = set(np.flatnonzero(~disabled[teams == 0].astype(bool)).tolist())
+        for mode in modes:
+            metadata = {'task_id': task.task_id, **condition_metadata(task.task_id, mode)}
+            replaced = set(mode['policies'])
+            if replaced and (not replaced < active or max(replaced) >= max_allies):
+                reason = f'replace={sorted(replaced)}, enabled allies={sorted(active)}; retain one model ally'
+                if invalid_policy == 'error':
+                    raise ValueError(f'{task.task_id}/{mode["name"]}: {reason}')
+                skipped.append({**metadata, 'reason': reason})
+            else:
+                # No task-provided strings become filesystem paths.
+                digest = hashlib.sha256(metadata['condition_id'].encode()).hexdigest()[:20]
+                jobs.append({'metadata': metadata, 'mode': mode, 'directory': 'condition_' + digest})
+    return jobs, skipped
+
+
+def completed_result(job, episodes, seed):
+    """Require both a completed summary and a matching full episode history."""
+    directory = Path(job['output'])
+    try:
+        payload = json.loads((directory / 'summary.json').read_text())
+        results = payload['tasks']
+        if payload.get('status') != 'complete' or len(results) != 1:
+            return None
+        result = results[0]
+        if any(result.get(k) != v for k, v in job['metadata'].items()):
+            return None
+        if result['episodes'] != episodes or result['seed_start'] != seed or result['seed_end'] != seed + episodes - 1:
+            return None
+        with (directory / 'episodes.csv').open(newline='') as f:
+            rows = list(csv.DictReader(f))
+        if len(rows) != episodes:
+            return None
+        for i, row in enumerate(rows):
+            if int(row['episode']) != i + 1 or int(row['seed']) != seed + i:
+                return None
+            if any(row.get(k) != str(v) for k, v in job['metadata'].items()):
+                return None
+        return result
+    except (OSError, ValueError, KeyError, TypeError):
+        return None
+
+
+def run_workers(jobs, limit, environment, on_finish):
+    """Refill slots on completion; terminate all child process groups on interruption."""
+    running = {}
+    pending = iter(jobs)
+    exhausted = False
+    previous = {}
+    def interrupt(signum, frame):
+        raise KeyboardInterrupt
+    for sig in (signal.SIGINT, signal.SIGTERM):
+        previous[sig] = signal.signal(sig, interrupt)
+    try:
+        while running or not exhausted:
+            while len(running) < limit and not exhausted:
+                job = next(pending, None)
+                if job is None:
+                    exhausted = True
+                    break
+                Path(job['output']).mkdir(parents=True, exist_ok=True)
+                log = (Path(job['output']) / 'eval.log').open('a', buffering=1)
+                log.write('\n--- worker start ---\n')
+                try:
+                    proc = subprocess.Popen(job['command'], env=environment, stdout=log,
+                                            stderr=subprocess.STDOUT, start_new_session=True)
+                except BaseException:
+                    log.close()
+                    raise
+                running[proc.pid] = (proc, job, log)
+                print(f"[started] {job['metadata']['condition_id']} pid={proc.pid} log={log.name}", flush=True)
+            for pid, (proc, job, log) in list(running.items()):
+                code = proc.poll()
+                if code is None:
+                    continue
+                log.close()
+                del running[pid]
+                on_finish(job, code)
+            if running:
+                time.sleep(.2)
+    finally:
+        # Ignore additional termination signals while cleaning up children.
+        for sig in previous:
+            signal.signal(sig, signal.SIG_IGN)
+        for proc, job, log in running.values():
+            try:
+                os.killpg(proc.pid, signal.SIGTERM)
+            except ProcessLookupError:
+                pass
+        deadline = time.monotonic() + 5
+        for proc, job, log in running.values():
+            try:
+                proc.wait(timeout=max(.01, deadline - time.monotonic()))
+            except subprocess.TimeoutExpired:
+                try:
+                    os.killpg(proc.pid, signal.SIGKILL)
+                except ProcessLookupError:
+                    pass
+                proc.wait()
+            log.close()
+        for sig, handler in previous.items():
+            signal.signal(sig, handler)
+
+
+def file_identity(path):
+    path = Path(path).expanduser().resolve()
+    stat = path.stat()
+    return {'path': str(path), 'size': stat.st_size, 'mtime_ns': stat.st_mtime_ns}
+
+
+def merge_episodes(root, jobs, completed):
+    temporary = root / 'episodes.csv.tmp'
+    with temporary.open('w', newline='') as handle:
+        writer = None
+        for job in jobs:
+            if job['metadata']['condition_id'] not in completed:
+                continue
+            with (Path(job['output']) / 'episodes.csv').open(newline='') as source:
+                reader = csv.DictReader(source)
+                if writer is None:
+                    writer = csv.DictWriter(handle, fieldnames=reader.fieldnames)
+                    writer.writeheader()
+                writer.writerows(reader)
+    temporary.replace(root / 'episodes.csv')
+
+
+def main():
+    import yaml
+    cli = parse_args()
+    config = load_yaml_config(cli.config)
+    config.pop('_config_path', None)
+    config.setdefault('training', {})['device'] = 'cuda'
+    config['retrieval']['faiss_threads'] = cli.faiss_threads
+    config['retrieval']['trace_search'] = False
+    manifest = TabxManifest(Path(config['data']['manifest']))
+    tasks = [manifest.task(t) for t in cli.task_ids] if cli.task_ids else list(manifest.tasks)
+    if not tasks or len({t.task_id for t in tasks}) != len(tasks):
+        raise ValueError('Tasks must be nonempty and unique')
+    modes = load_teammate_modes(cli.teammate_config)
+    raw_root = infer_raw_data_root(manifest, tasks, cli.raw_data_root)
+    definitions = load_task_definitions(manifest, tasks, raw_root, cli.task_package_root)
+    max_allies = cli.max_allies if cli.max_allies is not None else int(config['model'].get('max_agents', manifest.max_agents))
+    jobs, skipped = plan_conditions(tasks, definitions, modes, max_allies, cli.invalid_mode_policy)
+    for item in skipped:
+        print(f"[skip] {item['condition_id']}: {item['reason']}", flush=True)
+    print(f'[plan] tasks={len(tasks)} valid_conditions={len(jobs)} skipped={len(skipped)} '
+          f'gpu={cli.gpu_id} parallel_jobs={cli.parallel_jobs} episodes_per_condition={cli.episodes}', flush=True)
+    if not jobs:
+        raise ValueError('No valid conditions')
+    if cli.dry_run:
+        print(json.dumps([j['metadata'] for j in jobs], ensure_ascii=False, indent=2))
+        return 0
+    root = cli.output_dir.expanduser().resolve()
+    spec = json.loads(json.dumps({
+        'schema': 'tabx_parallel_v1', 'config': config,
+        'checkpoint': file_identity(cli.checkpoint / 'agent.th'),
+        'manifest': file_identity(manifest.path),
+        'normalization': file_identity(config['data']['normalization']),
+        'index_manifest': file_identity(config['retrieval']['index_manifest']),
+        'episodes': cli.episodes, 'seed': cli.seed, 'episode_limit': cli.episode_limit,
+        'capacities': [cli.max_allies, cli.max_enemies, cli.max_zones],
+        'online_memory': not cli.disable_online_memory,
+        'tabx_root': str(cli.tabx_root.resolve()), 'raw_root': str(raw_root),
+        'task_package_roots': [str(p.resolve()) for p in cli.task_package_root],
+        'definitions': {t.task_id: {'task': definitions[t.task_id].task,
+                                  'physics': definitions[t.task_id].physics_name,
+                                  'enemy': definitions[t.task_id].enemy_heuristic_name} for t in tasks},
+        'conditions': [j['metadata'] for j in jobs], 'skipped': skipped,
+    }))
+    import fcntl
+    root.mkdir(parents=True, exist_ok=True)
+    lock = (root / '.parallel.lock').open('a')
+    try:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    except BlockingIOError:
+        raise ValueError('Another parallel evaluator owns this output directory')
+    plan_path = root / 'parallel_spec.json'
+    if plan_path.exists():
+        if not cli.resume:
+            raise ValueError('Output exists; use --resume or a new --output-dir')
+        if json.loads(plan_path.read_text()) != spec:
+            raise ValueError('Parallel resume configuration/checkpoint mismatch; use a new output directory')
+    elif any(p.name != '.parallel.lock' for p in root.iterdir()):
+        raise ValueError('Output is not an empty parallel evaluation directory; choose a new directory')
+    root.mkdir(parents=True, exist_ok=True)
+    atomic_json(plan_path, spec)
+    configs = root / 'configs'
+    configs.mkdir(exist_ok=True)
+    worker_config = configs / 'evaluation.yaml'
+    worker_config.write_text(yaml.safe_dump(config, sort_keys=False))
+    for mode in modes:
+        (configs / (mode['name'] + '.yaml')).write_text(yaml.safe_dump({'teammate_modes': [mode]}, sort_keys=False))
+    environment = dict(os.environ)
+    environment.update(CUDA_VISIBLE_DEVICES=str(cli.gpu_id), JAX_PLATFORMS='cpu',
+                       JAX_DISABLE_JIT='False', XLA_PYTHON_CLIENT_PREALLOCATE='false',
+                       PYTHONUNBUFFERED='1', OMP_NUM_THREADS=str(cli.cpu_threads),
+                       MKL_NUM_THREADS=str(cli.cpu_threads), OPENBLAS_NUM_THREADS=str(cli.cpu_threads),
+                       NUMEXPR_NUM_THREADS=str(cli.cpu_threads))
+    allowed_cpus = sorted(os.sched_getaffinity(0)) if cli.cpus_per_job else []
+    if cli.cpus_per_job and not shutil.which('taskset'):
+        raise ValueError('taskset is required for CPU affinity; use --cpus-per-job 0 to disable')
+    if cli.cpus_per_job and cli.parallel_jobs * cli.cpus_per_job > len(allowed_cpus):
+        print('[cpu] Workers will share CPU cores; lower concurrency if CPU-bound', flush=True)
+    # Children see the selected physical GPU as cuda:0; each owns its model/store.
+    results, failures, pending = {}, {}, []
+    for job_number, job in enumerate(jobs):
+        job['output'] = str(root / job['directory'])
+        cmd = [sys.executable, '-u', str(ROOT / 'tools/eval_tabx_online.py'),
+               '--config', str(worker_config), '--checkpoint', str(cli.checkpoint.resolve()),
+               '--task-id', job['metadata']['task_id'], '--teammate-config',
+               str(configs / (job['mode']['name'] + '.yaml')),
+               '--episodes', str(cli.episodes), '--seed', str(cli.seed),
+               '--episode-limit', str(cli.episode_limit), '--tabx-root', str(cli.tabx_root.resolve()),
+               '--output-dir', job['output']]
+        if raw_root is not None:
+            cmd += ['--raw-data-root', str(raw_root)]
+        for p in cli.task_package_root:
+            cmd += ['--task-package-root', str(p.resolve())]
+        for name in ('allies', 'enemies', 'zones'):
+            value = getattr(cli, 'max_' + name)
+            if value is not None:
+                cmd += ['--max-' + name, str(value)]
+        if cli.disable_online_memory:
+            cmd += ['--disable-online-memory']
+        if cli.resume:
+            cmd += ['--resume']
+        if allowed_cpus:
+            count = min(cli.cpus_per_job, len(allowed_cpus))
+            cpus = [allowed_cpus[(job_number * count + i) % len(allowed_cpus)] for i in range(count)]
+            cmd = [shutil.which('taskset'), '-c', ','.join(map(str, cpus))] + cmd
+        job['command'] = cmd
+        result = completed_result(job, cli.episodes, cli.seed) if cli.resume else None
+        if result is not None:
+            results[job['metadata']['condition_id']] = result
+        else:
+            pending.append(job)
+    atomic_json(root / 'jobs.json', {'jobs': jobs, 'skipped': skipped})
+
+    def save(status):
+        rows = [dict(results[j['metadata']['condition_id']]) for j in jobs if j['metadata']['condition_id'] in results]
+        add_baseline_deltas(rows)
+        atomic_json(root / 'summary.json', {
+            'status': status, 'requested_conditions': len(jobs) + len(skipped),
+            'scheduled_conditions': len(jobs), 'completed_conditions': len(rows),
+            'failed_conditions': list(failures.values()), 'skipped_conditions': skipped,
+            'episodes_per_condition': cli.episodes, 'gpu_id': cli.gpu_id,
+            'parallel_jobs': cli.parallel_jobs, 'tasks': rows,
+        })
+        temporary = root / 'summary.csv.tmp'
+        fields = list(dict.fromkeys(k for row in rows for k in row)) or ['task_id', 'teammate_mode']
+        with temporary.open('w', newline='') as handle:
+            writer = csv.DictWriter(handle, fieldnames=fields)
+            writer.writeheader()
+            writer.writerows(rows)
+        temporary.replace(root / 'summary.csv')
+
+    def on_finish(job, code):
+        cid = job['metadata']['condition_id']
+        result = completed_result(job, cli.episodes, cli.seed) if code == 0 else None
+        if result is None:
+            failures[cid] = {'condition_id': cid, 'exit_code': code, 'log': str(Path(job['output']) / 'eval.log')}
+            print(f'[failed] {cid} exit={code}; see {failures[cid]["log"]}', flush=True)
+        else:
+            results[cid] = result
+            print(f'[complete] {cid} win_rate={result["win_rate"]:.4f} ({len(results)}/{len(jobs)})', flush=True)
+        save('running')
+
+    save('running')
+    try:
+        run_workers(pending, cli.parallel_jobs, environment, on_finish)
+    except KeyboardInterrupt:
+        save('interrupted')
+        merge_episodes(root, jobs, results)
+        return 130
+    except Exception:
+        save('failed')
+        raise
+    save('complete' if not failures else 'failed')
+    merge_episodes(root, jobs, results)
+    return 1 if failures else 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
