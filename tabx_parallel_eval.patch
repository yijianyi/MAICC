+import csv
+import importlib.util
+import json
+import os
+from pathlib import Path
+import signal
+import sys
+from types import SimpleNamespace as NS
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+spec = importlib.util.spec_from_file_location('parallel_eval', ROOT / 'tools/eval_tabx_parallel.py')
+ev = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(ev)
+
+
+def test_plan_skips_two_ally_replacement_but_retains_baseline():
+    tasks = [NS(task_id='two'), NS(task_id='three')]
+    definitions = {t.task_id: NS(task={'scenario': {'teams': [0]*n+[1]}})
+                   for t, n in zip(tasks, [2, 3])}
+    modes = [{'name': 'all_model', 'policies': {}},
+             {'name': 'novice_0_1', 'policies': {0: 'novice', 1: 'novice'}}]
+    jobs, skipped = ev.plan_conditions(tasks, definitions, modes, 10, 'skip')
+    assert len(jobs) == 3 and len(skipped) == 1
+    assert skipped[0]['task_id'] == 'two'
+    with pytest.raises(ValueError):
+        ev.plan_conditions(tasks, definitions, modes, 10, 'error')
+
+
+def test_scheduler_limits_concurrency_and_continues_after_failure(tmp_path):
+    code = '''import json,os,sys,time
+from pathlib import Path
+start=time.monotonic()
+time.sleep(.3)
+Path(sys.argv[1]).write_text(json.dumps([start,time.monotonic(),os.environ['CUDA_VISIBLE_DEVICES']]))
+sys.exit(int(sys.argv[2]))
+'''
+    jobs = [{'metadata': {'condition_id': str(i)}, 'output': str(tmp_path / str(i)),
+             'command': [sys.executable, '-c', code, str(tmp_path / f'{i}.json'), str(i == 1 and 1 or 0)]}
+            for i in range(5)]
+    finished = []
+    ev.run_workers(jobs, 2, {**os.environ, 'CUDA_VISIBLE_DEVICES': '0'},
+                   lambda job, code: finished.append(code))
+    assert sorted(finished) == [0, 0, 0, 0, 1]
+    events = []
+    for i in range(5):
+        start, end, gpu = json.loads((tmp_path / f'{i}.json').read_text())
+        assert gpu == '0'
+        events.extend([(start, 1), (end, -1)])
+    active = peak = 0
+    for _, delta in sorted(events):
+        active += delta
+        peak = max(peak, active)
+    assert peak == 2
+
+
+def test_cleanup_reaps_other_workers_when_callback_interrupts(tmp_path):
+    jobs = [{'metadata': {'condition_id': str(i)}, 'output': str(tmp_path / str(i)),
+             'command': [sys.executable, '-c',
+                         'import os,sys,time; from pathlib import Path; '
+                         'Path(sys.argv[1]).write_text(str(os.getpid())); time.sleep(float(sys.argv[2]))',
+                         str(tmp_path / f'{i}.pid'), delay]}
+            for i, delay in enumerate(['.3', '60'])]
+    def stop(*args):
+        raise KeyboardInterrupt
+    with pytest.raises(KeyboardInterrupt):
+        ev.run_workers(jobs, 2, os.environ.copy(), stop)
+    for p in tmp_path.glob('*.pid'):
+        with pytest.raises(ProcessLookupError):
+            os.kill(int(p.read_text()), 0)
+
+
